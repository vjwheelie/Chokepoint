# Copy to .env and fill in. .env is gitignored.

# SAM.gov public API key (https://sam.gov → Profile → Public API Key).
# Note: a non-federal key with no SAM role is limited to 10 requests/day — we use the extract endpoints for that reason.
SAM_API_KEY=

# Anthropic API key (needed from M5 onward).
ANTHROPIC_API_KEY=
